# =========================================================
# DS ModelForge — Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to source control
# =========================================================

# ── Application ──────────────────────────────────────────
APP_ENV=development                   # development | production
SECRET_KEY=changeme-use-openssl-rand-hex-32
ALLOWED_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL 16 + pgvector) ──────────────────
DATABASE_URL=postgresql+asyncpg://modelforge:modelforge@localhost:5432/modelforge
SYNC_DATABASE_URL=postgresql://modelforge:modelforge@localhost:5432/modelforge

# ── LLM — LiteLLM pluggable ──────────────────────────────
# Uncomment the provider you want to use (or set all for pluggable)
LLM_PROVIDER=openai                   # openai | azure | anthropic
LLM_MODEL=gpt-4o                      # model name for chosen provider
LLM_TEMPERATURE=0                     # always 0 for deterministic output

# OpenAI
OPENAI_API_KEY=sk-...

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-02-01

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# ── Embeddings (Local — no API cost) ─────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2     # local sentence-transformers model
EMBEDDING_DIMENSION=384

# ── SAP Datasphere Connection ─────────────────────────────
# These are set at runtime per-connection; shown here for default dev tenant
# NEVER store client_secret in DB — env only
DS_TOKEN_URL=https://<your-btp-account>.authentication.sap.hana.ondemand.com/oauth/token
DS_CLIENT_ID=sb-...
DS_CLIENT_SECRET=...
DS_TENANT_HOST=https://<your-tenant>.eu10.hcs.cloud.sap
DS_SPACE=SALES                        # default space for dev
DS_RELEASE=2024.Q3                    # Datasphere release version

# JDBC (HANA) — provide path to ngdbc.jar after downloading from SAP
JDBC_DRIVER_PATH=/opt/jdbc/ngdbc.jar
JDBC_DRIVER_CLASS=com.sap.db.jdbc.Driver

# ── Security ─────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480   # 8 hours
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536

# ── Feature Flags ─────────────────────────────────────────
PROFILING_SAMPLE_ROWS=10000000        # tables > this threshold are sampled
PROFILING_TOP_K=20                    # top-k values for non-PII columns
ASSOCIATION_ORPHAN_THRESHOLD=0.02     # 2% orphan ratio warning threshold
CONFIDENCE_FLAG_THRESHOLD=0.75        # red badge below this

# ── Worker ───────────────────────────────────────────────
WORKER_CONCURRENCY=4
LANGGRAPH_INTERRUPT_TIMEOUT=3600      # 1 hour for human approval gates
